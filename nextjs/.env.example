# In CodeSandbox, set these in the Devbox "Env vars" panel instead of a .env file.
# Only the first two are required.

# Required — Shopify Storefront API
SHOPIFY_STORE_DOMAIN="your-store.myshopify.com"
SHOPIFY_STOREFRONT_ACCESS_TOKEN="your-storefront-access-token"

# Store display name (shown in header, metadata, etc.)
NEXT_PUBLIC_SITE_NAME="Storesynk Demo"

# Optional — AI shopping assistant (AI SDK). Overrides shop.config.ts; use "1" or "0".
# The agent's model routes through the Vercel AI Gateway: on Vercel the project's
# OIDC token is used automatically; elsewhere set AI_GATEWAY_API_KEY, or run
# `vercel link` to mint a VERCEL_OIDC_TOKEN for local dev.
# NEXT_PUBLIC_ENABLE_AGENT="1"
# AI_GATEWAY_API_KEY="your-ai-gateway-api-key"

# Optional — Customer Authentication (Hydrogen + Shopify Customer Account API).
# The flag overrides shop.config.ts; use "1" or "0".
# Generate the app-owned cookie encryption secret with `openssl rand -base64 32`.
# NEXT_PUBLIC_ENABLE_AUTH="1"
# CUSTOMER_ACCOUNT_SESSION_SECRET="your-random-session-secret"
# SHOPIFY_CUSTOMER_ACCOUNT_API_CLIENT_ID="your-customer-account-client-id"

# Optional — Base URL for absolute links (sitemap, OG tags, auth callbacks).
# Inside a CodeSandbox Devbox it defaults to https://${CSB_SANDBOX_ID}-3000.csb.app,
# on Vercel to https://${VERCEL_PROJECT_PRODUCTION_URL}, otherwise localhost:3000.
# NEXT_PUBLIC_BASE_URL="https://your-domain.com"

# Optional — Shopify webhook signature verification.
# Required if you wire up /api/webhooks/shopify.
# SHOPIFY_WEBHOOK_SECRET="your-webhook-secret"

# Optional — CMS draft mode (preview unpublished metaobject content).
# Required if you use /api/draft for CMS preview links.
# CMS_DRAFT_MODE_SECRET="your-draft-mode-secret"

# Optional — Override the Shopify Storefront API version. Defaults to unstable.
# SHOPIFY_API_VERSION="unstable"

# Optional — Verbose Shopify Storefront API request logging in the server console.
# DEBUG_SHOPIFY="true"

# Optional — UCP agent profile URL for the Storefront MCP catalog search (agent/tools/search_catalog.ts).
# Only needed if your store requires it; the standard /api/mcp endpoint usually works without it.
# UCP_AGENT_PROFILE_URL="https://your-agent.example.com/.well-known/ucp"

# Optional — Showcase product overrides for the PDP examples (/pdp-examples/*). Unset, each
# page discovers a product from the live offers the Storesynk app publishes and shows an
# empty state when there is none. Set one to pin the page to a specific product handle.
# NEXT_PUBLIC_BUNDLE_TEST_HANDLE="your-bundle-member-product"
# NEXT_PUBLIC_MM_TEST_HANDLE="your-mix-match-product"
# NEXT_PUBLIC_PA_TEST_HANDLE="your-add-ons-product"
# NEXT_PUBLIC_VD_TEST_HANDLE="your-volume-discount-product"
